{
	"name": "quillmark-js",
	"private": true,
	"description": "The JS tier downstream of the @quillmark/wasm artifact.",
	"license": "Apache-2.0",
	"type": "module",
	"packageManager": "npm@11.17.0",
	"engines": {
		"node": ">=24"
	},
	"workspaces": [
		"packages/*"
	],
	"scripts": {
		"dev": "npm run dev -w packages/playground",
		"dev:studio": "npm run dev -w packages/quillkit",
		"build": "npm run build -w packages/quiver -w packages/svelte && npm run build -w packages/quillkit -w packages/playground",
		"site": "node packages/quillkit/dist/bin/quillkit.js site --quiver fixtures --out site",
		"check": "npm run check --workspaces --if-present",
		"test": "npm run test --workspaces --if-present",
		"lint": "prettier --check .",
		"format": "prettier --write .",
		"check:docs": "node scripts/check-docs.mjs",
		"check:style": "node scripts/check-style.mjs",
		"check:deps": "node scripts/check-deps.mjs",
		"check:bundle": "node scripts/check-style.mjs --built",
		"check:pack": "npm run check:pack --workspaces --if-present",
		"check:registry": "node scripts/check-registry.mjs",
		"gate:fast": "npm run lint && npm run check && npm run check:docs && npm run check:style && npm run check:deps",
		"gate": "npm run gate:fast && npm run build && npm run check:bundle && npm test"
	},
	"overrides": {
		"@quillmark/wasm": "0.113.0"
	},
	"devDependencies": {
		"@quillmark/wasm": "0.113.0",
		"postcss": "^8.5.0",
		"prettier": "^3.4.0",
		"prettier-plugin-svelte": "^3.3.0"
	}
}
