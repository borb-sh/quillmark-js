// The type check, which reaches the tests that `tsconfig.json` keeps out of `dist`.
{
	"extends": "./tsconfig.json",
	"compilerOptions": {
		"noEmit": true,
		// Nothing is emitted, so the build's `src` root does not apply and the config
		// files beside it come into the program.
		"rootDir": "."
	},
	"include": ["src", "tests", "vitest.config.ts"],
	"exclude": []
}
