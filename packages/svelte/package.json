{
	"name": "@quillmark/svelte",
	"version": "0.10.1",
	"description": "Editor, live-preview and source surfaces over a Quillmark WASM session.",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/borb-sh/quillmark-js.git",
		"directory": "packages/svelte"
	},
	"bugs": {
		"url": "https://github.com/borb-sh/quillmark-js/issues"
	},
	"homepage": "https://github.com/borb-sh/quillmark-js/tree/main/packages/svelte#readme",
	"license": "Apache-2.0",
	"keywords": [
		"quillmark",
		"svelte",
		"editor",
		"wysiwyg",
		"typst",
		"markdown"
	],
	"author": "Quillmark Contributors",
	"type": "module",
	"engines": {
		"node": ">=24"
	},
	"svelte": "./dist/index.js",
	"types": "./dist/index.d.ts",
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"svelte": "./dist/index.js",
			"default": "./dist/index.js"
		},
		"./core": {
			"types": "./dist/core/index.d.ts",
			"svelte": "./dist/core/index.js",
			"default": "./dist/core/index.js"
		},
		"./preview": {
			"types": "./dist/preview/index.d.ts",
			"svelte": "./dist/preview/index.js",
			"default": "./dist/preview/index.js"
		},
		"./visual": {
			"types": "./dist/visual/index.d.ts",
			"svelte": "./dist/visual/index.js",
			"default": "./dist/visual/index.js"
		},
		"./preset": "./dist/preset/index.css"
	},
	"files": [
		"dist",
		"THEMING.md",
		"NOTICE"
	],
	"sideEffects": true,
	"scripts": {
		"build": "svelte-package",
		"prepare": "npm run build",
		"prepack": "rm -rf dist && npm run build",
		"check:pack": "publint",
		"test": "vitest run",
		"test:watch": "vitest",
		"check": "svelte-check --tsconfig ./tsconfig.json"
	},
	"peerDependencies": {
		"@quillmark/wasm": ">=0.113.0-0",
		"svelte": "^5.0.0"
	},
	"dependencies": {
		"@internationalized/date": "^3.12.2",
		"bits-ui": "^2.0.0",
		"prosemirror-commands": "1.7.1",
		"prosemirror-gapcursor": "1.3.2",
		"prosemirror-history": "1.5.0",
		"prosemirror-inputrules": "1.5.1",
		"prosemirror-keymap": "1.2.3",
		"prosemirror-model": "1.25.11",
		"prosemirror-schema-list": "1.5.1",
		"prosemirror-state": "1.4.4",
		"prosemirror-transform": "1.12.0",
		"prosemirror-view": "1.42.1"
	},
	"devDependencies": {
		"@sveltejs/package": "^2.5.0",
		"@sveltejs/vite-plugin-svelte": "^6.0.0",
		"@types/node": "^26.1.1",
		"jsdom": "^29.1.1",
		"publint": "^0.3.0",
		"svelte": "^5.0.0",
		"svelte-check": "^4.1.0",
		"typescript": "^5.7.0",
		"vitest": "^4.1.10"
	},
	"publishConfig": {
		"access": "public"
	}
}
