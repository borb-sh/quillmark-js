{
	"name": "@quillmark/quiver",
	"version": "0.27.0",
	"description": "A quiver of Quillmark quills: load one, pack one, hand out quills.",
	"type": "module",
	"license": "Apache-2.0",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/borb-sh/quillmark-js.git",
		"directory": "packages/quiver"
	},
	"bugs": {
		"url": "https://github.com/borb-sh/quillmark-js/issues"
	},
	"homepage": "https://github.com/borb-sh/quillmark-js/tree/main/packages/quiver#readme",
	"keywords": [
		"quillmark",
		"quiver",
		"typst",
		"markdown"
	],
	"author": "Quillmark Contributors",
	"engines": {
		"node": ">=24"
	},
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"import": "./dist/index.js",
			"default": "./dist/index.js"
		},
		"./node": {
			"types": "./dist/node.d.ts",
			"import": "./dist/node.js",
			"default": "./dist/node.js"
		}
	},
	"sideEffects": false,
	"files": [
		"dist",
		"MIGRATION.md",
		"NOTICE"
	],
	"peerDependencies": {
		"@quillmark/wasm": ">=0.113.0-0"
	},
	"dependencies": {
		"fflate": "^0.8.2",
		"yaml": "^2.8.3"
	},
	"devDependencies": {
		"@types/node": "^25.3.3",
		"publint": "^0.3.0",
		"typescript": "^5.9.3",
		"vitest": "^4.0.18"
	},
	"scripts": {
		"build": "tsc",
		"prepare": "npm run build",
		"prepack": "rm -rf dist && npm run build",
		"test": "vitest run",
		"check": "tsc --noEmit -p tsconfig.check.json",
		"check:pack": "publint"
	},
	"publishConfig": {
		"access": "public"
	}
}
