{
	"name": "quillkit",
	"version": "0.13.0",
	"description": "The quill author's toolchain: gate a quiver, pack it, look at it, ship it. Carries the studio client it serves.",
	"type": "module",
	"license": "Apache-2.0",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/borb-sh/quillmark-js.git",
		"directory": "packages/quillkit"
	},
	"bugs": {
		"url": "https://github.com/borb-sh/quillmark-js/issues"
	},
	"homepage": "https://github.com/borb-sh/quillmark-js/tree/main/packages/quillkit#readme",
	"keywords": [
		"quillmark",
		"quiver",
		"typst",
		"markdown",
		"cli"
	],
	"author": "Quillmark Contributors",
	"engines": {
		"node": ">=24"
	},
	"files": [
		"dist",
		"NOTICE"
	],
	"exports": {},
	"bin": {
		"quillkit": "./dist/bin/quillkit.js"
	},
	"scripts": {
		"dev": "vite",
		"build": "tsc && vite build",
		"prepack": "rm -rf dist && npm run build",
		"test": "vitest run",
		"check": "svelte-check --tsconfig ./tsconfig.client.json --fail-on-warnings && tsc --noEmit -p tsconfig.check.json",
		"check:pack": "publint"
	},
	"devDependencies": {
		"@quillmark/quiver": "*",
		"@quillmark/svelte": "*",
		"@quillmark/wasm": ">=0.122.0-0",
		"@sveltejs/vite-plugin-svelte": "^7.3.0",
		"@types/node": "^24.19.1",
		"publint": "^0.3.25",
		"svelte": "^5.54.0",
		"svelte-check": "^4.7.6",
		"typescript": "^6.0.0",
		"vite": "^8.3.0",
		"vitest": "^5.0.0"
	},
	"publishConfig": {
		"access": "public"
	}
}
