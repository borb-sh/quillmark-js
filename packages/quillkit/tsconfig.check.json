// The type check, which reaches the tests that `tsconfig.json` keeps out of `dist`.
//
// The three configs come in with it: they run in Node, and `svelte-check` reads none of
// them, the clients' program being `tsconfig.client.json`. `tests/app/` reads the app's
// modules, so it is that program's.
{
	"extends": "./tsconfig.json",
	"compilerOptions": {
		"noEmit": true,
		// Nothing is emitted, so the build's `src` root does not apply and the config
		// files beside it come into the program.
		"rootDir": "."
	},
	"include": ["src", "tests", "vitest.config.ts", "vite.config.ts", "vite.app.config.ts"],
	"exclude": ["tests/app"]
}
