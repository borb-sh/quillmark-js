{
	"hooks": {
		"SessionStart": [
			{
				"hooks": [
					{
						"type": "command",
						"command": "$CLAUDE_PROJECT_DIR/.claude/hooks/session-start.sh"
					}
				]
			}
		]
	},
	"permissions": {
		"allow": [
			"Bash(npm run gate:*)",
			"Bash(npm run check:*)",
			"Bash(npm run lint:*)",
			"Bash(npm run format:*)",
			"Bash(npm run build:*)",
			"Bash(npm run test:*)",
			"Bash(npm test:*)",
			"Bash(npm run dev:*)",
			"Bash(npm run probe:*)",
			"Bash(npx vitest:*)",
			"Bash(npx prettier --check:*)"
		]
	}
}
