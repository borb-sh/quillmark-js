# Logs
logs
*.log
npm-debug.log*

# Coverage
coverage
*.lcov

# Dependencies
node_modules/

# Build output
dist
*.tsbuildinfo
*.tgz

# SvelteKit cache
.svelte-kit/

# SvelteKit adapter-static playground output
packages/*/build/

# The fixture quiver, packed into each client's served tree before dev/build.
packages/playground/static/quiver/
packages/quillkit/client/public/quiver/

# Studio laid out beside a built quiver, the way a deploy serves it (`npm run site`).
/site/

# dotenv environment variable files
.env
.env.*
!.env.example

# Vite files
vite.config.js.timestamp-*
vite.config.ts.timestamp-*
.vite/

# Agent scratch in a package's tree: a throwaway probe belongs in the session's own
# scratchpad, outside the worktree. Brace alternation is not gitignore syntax, so each
# marker is its own line.
zz*.test.ts
zprobe*.test.ts
tmp-*.test.ts
scratch*.test.ts
probe*.test.ts
refute*.test.ts
